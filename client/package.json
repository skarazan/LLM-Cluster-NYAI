{
  "name": "llm-cluster-client",
  "version": "1.0.4",
  "description": "Chat client for LLM Cluster",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.llmcluster.client",
    "productName": "LLM Cluster Chat",
    "publish": {
      "provider": "github",
      "owner": "skarazan",
      "repo": "LLM-Cluster-NYAI"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "files": [
      "main.js",
      "renderer/**/*"
    ]
  }
}
