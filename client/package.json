{
  "name": "llm-cluster-client",
  "version": "1.0.0",
  "description": "Chat client for LLM Cluster",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.llmcluster.client",
    "productName": "LLM Cluster Chat",
    "publish": {
      "provider": "github",
      "owner": "skarazan",
      "repo": "LLM-Cluster-NYAI"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "renderer/**/*"
    ]
  }
}
